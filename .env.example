# Copiez ce fichier en « .env.local » et remplissez les valeurs.

# Clé secrète Stripe : https://dashboard.stripe.com/test/apikeys
# Commencez par la clé de TEST (sk_test_...), puis passez à la clé live (sk_live_...) au lancement.
STRIPE_SECRET_KEY=sk_test_xxx

# Adresse publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
