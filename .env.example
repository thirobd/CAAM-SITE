# Copiez ce fichier en « .env.local » et remplissez les valeurs.
# Collez chaque valeur juste après le « = », sans guillemets ni espaces.

# Adresse publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys, ou bouton « Connect ») ---
# Sans ces valeurs, le site utilise le catalogue de démonstration intégré.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : « publishable » (sb_publishable_…) ou « anon »
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé SECRÈTE : « secret » (sb_secret_…) ou « service_role ». Serveur uniquement,
# ne jamais la préfixer par NEXT_PUBLIC_ ni la partager.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : « demo » force le catalogue de démonstration même si Supabase est configuré.
# CATALOG_SOURCE=demo
